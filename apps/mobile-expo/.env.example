# The Android emulator (AVD) maps 10.0.2.2 to the host machine's localhost,
# so this default works out of the box when running on the emulator.
# On a physical device (or iOS simulator, which uses the host's own
# localhost), replace this with your machine's LAN IP, e.g.
# http://192.168.1.50:5195/api/v1 — the device must be able to reach it
# over the network.
EXPO_PUBLIC_API_BASE_URL=http://192.168.100.64:5195/api/v1
